<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:alertDialogTheme">@style/SettingsDialogTheme</item>
        <item name="android:colorAccent">#D00000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="SettingsDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/settings_background</item>
        <item name="android:colorBackground">@color/settings_red</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="android:colorControlNormal">#FFFFFF</item>
        <item name="android:colorControlActivated">#FFFFFF</item>
        <item name="android:colorButtonNormal">#760000</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#DDDDDD</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">94%</item>
    </style>
    <style name="SettingsFullscreenTheme" parent="SettingsDialogTheme">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>
</resources>
